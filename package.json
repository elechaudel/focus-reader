{
  "name": "focus-reader",
  "private": true,
  "type": "module",
  "description": "<focus-reader>: a text read a few words at a time, like subtitles, in a panel with its pace, size and progress. No dependency, no framework; an Astro integration and component too.",
  "exports": {
    ".": "./src/index.ts",
    "./element": "./src/element.ts",
    "./text": "./src/text.ts",
    "./register": "./src/register.ts",
    "./astro": "./astro/index.ts",
    "./astro/FocusReader.astro": "./astro/FocusReader.astro"
  },
  "scripts": {
    "check": "tsc -p .",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:unit": "node --test --no-warnings=ExperimentalWarning 'test/*.test.ts'",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "astro": "^7.4.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  }
}
