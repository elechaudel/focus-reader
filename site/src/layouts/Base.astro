---
// Frame shared by every page: the header pinned to the top of the window (the name, the three parts of the site,
// the links out, the theme), the page, then the footer. It loads elchdl's tokens and fonts, the readers' theme,
// and registers <focus-reader>, so a page (the documentation's Markdown included) can write one by hand.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';
import 'virtual:focus-reader/theme.css';
import pkg from '../../../package.json';
import ThemeToggle from '../components/ThemeToggle.astro';
import { GITHUB, LAB, NPM, url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const NAME = 'focus-reader';
const {
  title,
  description = 'A text read a few words at a time, like subtitles, in a panel with its pace, size and progress. One custom element, no dependency, no framework.',
} = Astro.props;
const path = Astro.url.pathname;
// the page's own address, once the site has one (SITE_URL)
const canonical = Astro.site && new URL(path, Astro.site);
const nav = [
  { href: url('docs/'), label: 'Docs' },
  { href: url('playground/'), label: 'Playground' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${NAME}` : NAME}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="theme-color" content="#F3F2EE" media="(prefers-color-scheme: light)" data-scheme="light" data-color="#F3F2EE" />
    <meta name="theme-color" content="#141514" media="(prefers-color-scheme: dark)" data-scheme="dark" data-color="#141514" />
    <script is:inline>
      // Apply the stored theme before the first paint, browser chrome included (see ThemeToggle.astro).
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
          const c = document.querySelector(`meta[data-scheme="${t}"]`).dataset.color;
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = c;
        }
      } catch {}
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={title ?? NAME} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <div class="shell">
      <header class="top">
        <div class="column bar">
          <a href={url()} class="home" aria-label={`${NAME}, home`}>
            <span class="mark" aria-hidden="true"></span>
            <span class="name">{NAME}</span>
          </a>
          <a href={`${NPM}/v/${pkg.version}`} class="version type-label" title="The version on npm" target="_blank" rel="noopener">v{pkg.version}</a>
          <!-- On phones the sections fold into a menu under the header, as on elchdl. -->
          <button type="button" class="menu type-label-sm" aria-expanded="false" aria-controls="sections">
            Menu<span class="chevron" aria-hidden="true">›</span>
          </button>
          <nav id="sections" aria-label="Sections">
            {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
            <a href={GITHUB} class="out" target="_blank" rel="noopener">GitHub<span aria-hidden="true"> ↗</span></a>
            <a href={NPM} class="out npm" target="_blank" rel="noopener">npm<span aria-hidden="true"> ↗</span></a>
          </nav>
          <ThemeToggle />
        </div>
      </header>

      <main><slot /></main>

      <footer class="foot">
        <div class="column">
          <p class="type-label">
            MIT licence · Started as a Lab experiment on <a href={LAB} target="_blank" rel="noopener">elchdl</a>
          </p>
        </div>
      </footer>
    </div>

    <script>
      import '../../../src/register.ts';
      import { bindCopy } from '../lib/clipboard';
      bindCopy();

      // The menu: on phones it opens the sections under the header, and closes on Escape, a click or a focus
      // elsewhere, or once the window is wide enough to show them in the header.
      const top = document.querySelector<HTMLElement>('header.top');
      const menu = top?.querySelector<HTMLButtonElement>('.menu');
      if (top && menu) {
        const phone = matchMedia('(max-width: 640px)');
        const open = (on: boolean, back = false) => {
          top.toggleAttribute('data-open', on);
          menu.setAttribute('aria-expanded', String(on));
          if (back) menu.focus();
        };
        const isOpen = () => top.hasAttribute('data-open');
        menu.addEventListener('click', () => open(!isOpen()));
        addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen()) open(false, true);
        });
        addEventListener('pointerdown', (e) => {
          if (isOpen() && !top.contains(e.target as Node)) open(false);
        });
        top.addEventListener('focusout', (e) => {
          if (isOpen() && e.relatedTarget && !top.contains(e.relatedTarget as Node)) open(false);
        });
        phone.addEventListener('change', () => open(false));
        // a page kept for Back comes back with its menu closed
        addEventListener('pagehide', () => open(false));
      }
    </script>
  </body>
</html>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
  main {
    flex: 1;
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--header-h);
    border-bottom: var(--spacing-hairline) solid var(--color-ink);
    background: var(--color-paper);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    height: 100%;
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    text-decoration: none;
  }
  /* the version, beside the name: the header's left group ends with it */
  .version {
    margin-right: auto;
    margin-left: calc(var(--spacing-sm) - var(--spacing-lg));
    padding-top: 3px;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .version:hover {
    color: var(--color-ink);
  }
  /* only on phones, where it holds the sections */
  .menu {
    display: none;
  }
  /* The mark: four cells, as elchdl's logo, in the reader's citron. */
  .mark {
    width: 16px;
    height: 16px;
    background:
      linear-gradient(var(--accent), var(--accent)) 0 0 / 50% 50% no-repeat,
      linear-gradient(var(--color-ink), var(--color-ink)) 100% 0 / 50% 50% no-repeat,
      linear-gradient(var(--color-ink), var(--color-ink)) 0 100% / 50% 50% no-repeat,
      linear-gradient(color-mix(in srgb, var(--accent) 45%, var(--color-paper)), color-mix(in srgb, var(--accent) 45%, var(--color-paper))) 100% 100% / 50% 50% no-repeat;
  }
  .name {
    font-family: var(--type-headline-sm-family);
    font-size: var(--type-headline-sm-size);
    line-height: 1;
  }
  nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    font-family: var(--type-label-family);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
  }
  nav a {
    padding-block: 6px;
    text-decoration: none;
    color: var(--color-text-muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-ink);
  }
  nav a[aria-current='page'] {
    box-shadow: inset 0 -1px var(--color-ink);
  }
  .foot {
    margin-top: var(--spacing-section);
    padding-block: var(--spacing-lg);
    border-top: var(--spacing-hairline) solid var(--color-ink);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .bar {
      gap: var(--spacing-md);
    }
    .version {
      margin-left: calc(var(--spacing-sm) - var(--spacing-md));
    }
    /* Menu in mono capitals, a chevron after it, turned down, up when open */
    .menu {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 32px;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      color: var(--color-ink);
      text-transform: uppercase;
      cursor: pointer;
    }
    .chevron {
      display: inline-block;
      font-size: 15px;
      line-height: 1;
      rotate: 90deg;
    }
    .menu[aria-expanded='true'] .chevron {
      rotate: -90deg;
    }
    /* The sections, just under the header's hairline and across the window: one row each, on hairlines */
    nav {
      display: none;
      position: absolute;
      top: calc(100% + var(--spacing-hairline));
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-inline: var(--page-x);
      border-bottom: var(--spacing-hairline) solid var(--color-ink);
      background: var(--color-paper);
    }
    .top[data-open] nav {
      display: flex;
    }
    nav a {
      display: flex;
      align-items: center;
      height: 48px;
      padding-block: 0;
      color: var(--color-ink);
    }
    nav a[aria-current='page'] {
      box-shadow: none;
    }
    nav a[aria-current='page']::before {
      content: '';
      width: 8px;
      height: 8px;
      margin-right: 10px;
      background: var(--accent);
    }
    nav a + a {
      border-top: var(--spacing-hairline) solid var(--color-rule);
    }
  }
  @media (max-width: 640px) and (hover: hover) {
    .menu:hover {
      color: var(--color-text-cobalt);
    }
  }
  @media (max-width: 640px) and (prefers-reduced-motion: no-preference) {
    .chevron {
      transition: rotate 0.2s ease;
    }
  }
</style>
